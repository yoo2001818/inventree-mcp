# The externally reachable HTTPS origin. Do not append /mcp.
PUBLIC_URL=https://inventree-mcp.example.com

# The single InvenTree instance used for all proxied requests.
# This must be reachable from the bridge container.
INVENTREE_URL=http://inventree-server:8000

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Password entered on the authorization page. Minimum 16 bytes.
# Generate with: openssl rand -base64 32
OWNER_PASSWORD=replace-with-a-long-random-password

# Use 0.0.0.0 only inside a container or behind a trusted network boundary.
BIND_HOST=127.0.0.1
PORT=3000
DATA_FILE=/data/state.json
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Exact origins allowed to receive OAuth callbacks. The two loopback-only
# :* patterns safely permit ephemeral callback ports for local clients.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com,http://localhost:*,http://127.0.0.1:*

# Trusted browser origins for MCP and OAuth CORS. Requests to /mcp with any
# other Origin header are rejected with HTTP 403.
ALLOWED_MCP_ORIGINS=https://chatgpt.com

# Development-only raw POST/PATCH/PUT escape hatch. Dedicated workflow tools
# with preview/commit plans are used by default.
ENABLE_RAW_WRITE=false

# Temporary part-image upload safety limits. Image bytes remain in memory and
# expire after 30 minutes; they are never serialized into the JSON plan store.
IMAGE_UPLOAD_MAX_BYTES=8388608
IMAGE_MAX_PIXELS=40000000
